<?xml version="1.0" encoding="UTF-8"?>
<!--
  SITEMAP — CATARSIS DRINKS & FOOD
  ================================================
  Indica a Google y otros buscadores las páginas
  del sitio y su prioridad de indexación.
  REGISTRAR EN:
  https://search.google.com/search-console
  → Sitemaps → Ingresar URL del sitemap → Enviar
  ACTUALIZAR lastmod cuando:
  - Cambien precios o platos en /menu
  - Se agreguen nuevas páginas al sitio
  - Se realicen cambios importantes en la home
  ================================================
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <!--
    HOME — Página principal
    Prioridad máxima: es la URL más importante del sitio.
    changefreq weekly: puede cambiar con promociones o eventos.
  -->
  <url>
    <loc>https://www.catarsiszone.com/</loc>
    <lastmod>2026-03-25</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <!--
    /menu — Carta completa del restaurante
    Página real e independiente desde marzo 2026.
    Contiene 8 categorías con precios en USD.
    Prioridad alta: es la segunda página más importante.
    changefreq weekly: se actualiza cuando cambia la carta.
  -->
  <url>
    <loc>https://www.catarsiszone.com/menu</loc>
    <lastmod>2026-03-25</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  <!--
    [2026-07-02] CATARSIS — RECORDATORIO
    A partir de esta fecha, las URLs de producto siguen el formato
    /{categoria}/{slug} (ej. /hamburguesas/smash-clasica).
    /producto/{slug} sigue funcionando pero redirige a la canónica.
    Al agregar/renombrar productos, sumar aquí una <url> con la
    URL canónica nueva y remover la vieja si aplica.
  -->
</urlset>
