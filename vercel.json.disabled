{
  "_comentario_1": "CONFIGURACIÓN VERCEL — CATARSIS DRINKS & FOOD",
  "_comentario_2": "rewrites: redirige todas las rutas a index.html para que React Router funcione correctamente en Vercel. Sin esto /menu daría error 404 al abrirse directamente desde una URL externa.",
  "_comentario_3": "headers: activa compresión y caché para mejorar velocidad de carga (Core Web Vitals).",
  "redirects": [],
  "rewrites": [
    { "source": "/best-seller", "destination": "/categoria/best-seller" },
    { "source": "/hamburguesas", "destination": "/categoria/hamburguesas" },
    { "source": "/pizzas", "destination": "/categoria/pizzas" },
    { "source": "/emparedados", "destination": "/categoria/emparedados" },
    { "source": "/parrilla", "destination": "/categoria/parrilla" },
    { "source": "/entradas", "destination": "/categoria/entradas" },
    { "source": "/ensaladas", "destination": "/categoria/ensaladas" },
    { "source": "/cocteleria", "destination": "/categoria/cocteleria" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    },
    {
      "source": "/favicon.(png|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ]
}
