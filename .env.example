# ============================================================
# REFERENCIA DE VARIABLES DE ENTORNO
# ============================================================
# Copia este archivo como .env y reemplaza con los valores reales.
# Nunca subas el .env real al repositorio.
#
# Estas variables son necesarias para conectar con Lovable Cloud
# (backend del proyecto). Sin ellas la app no podrá comunicarse
# con la base de datos ni con las funciones del servidor.
# ============================================================

# URL del proyecto en Lovable Cloud
# Se obtiene automáticamente al vincular el proyecto
VITE_SUPABASE_URL=tu_url_de_supabase_aqui

# Clave pública (anon key) para acceso desde el navegador
# Es segura de exponer en el frontend; las políticas RLS
# del backend controlan qué datos puede ver cada usuario
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui
